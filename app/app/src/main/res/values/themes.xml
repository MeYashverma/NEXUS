<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash → Theme.Elevon. Default (light system mode): Paper. -->
    <style name="Theme.Elevon.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/elevon_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Elevon</item>
    </style>

    <style name="Theme.Elevon" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/elevon_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
